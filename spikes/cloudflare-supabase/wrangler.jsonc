{
  "name": "travel-map-local-pg-poc",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "images": { "binding": "IMAGES", "remote": false },
  "dev": { "ip": "127.0.0.1", "port": 8788, "inspector_port": 9238 },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "poc-private-media-b", "remote": false }]
}
