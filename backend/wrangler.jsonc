{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travel-map-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "dev": { "ip": "127.0.0.1", "port": 8789, "local_protocol": "http" },
  "env": {
    "dev": { "name": "travel-map-api-dev", "vars": { "APP_ENV": "dev" } },
    "test": { "name": "travel-map-api-test", "vars": { "APP_ENV": "test" } },
    "prod": { "name": "travel-map-api-prod", "vars": { "APP_ENV": "prod" } }
  }
}
