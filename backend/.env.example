# Node-only migration tools; never bundled into the Worker.
# Copy to .env and use a NEW disposable LOCAL database, not a PoC or hosted DB.
DATABASE_URL=postgresql://travel_map_migrator:REPLACE_LOCALLY@127.0.0.1:5432/travel_map_dev
LOCAL_DATABASE_ONLY=1
# Optional: absolute directory containing compatible initdb, pg_ctl and postgres.
# PG_BIN=/absolute/path/to/postgresql/bin
